# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose. Used by Super Admin to create/reset admin accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Business shown on "/" when the request host doesn't match any business domain
DEFAULT_BUSINESS_SLUG=shababik

# Public base URL (used for canonical / Open Graph when no custom domain is set)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Used once by `npm run bootstrap`
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=change-me-to-a-long-password
# SHA-256 hash of the secret Super Admin console address — the address itself is never stored.
# Generate one with `npm run sa-hash` (or `npm run sa-hash -- /your-own-address`).
# /super-admin always returns 404. You can also sign in at /admin/login with the super admin email.
SUPER_ADMIN_PATH_HASH=
SHABABIK_ADMIN_EMAIL=owner@example.com
SHABABIK_ADMIN_PASSWORD=change-me-too
